{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewee-webchat-next",
  "account_id": "7ac87c90789159ae1b10b7d78f5dcc08",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "webchat-next.dewee.sh", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Public settings. Secrets (DEWEE_GATEWAY_TOKEN, DEWEE_WEBCHAT_SECRET) are set with
  // `wrangler secret put`, or in .dev.vars for local runs.
  "vars": {
    "DEWEE_GATEWAY_URL": "https://dewee.zuey.me",
    "DEWEE_AGENTS": "dewee-web-advisor,zuey-ai",
    "DEWEE_DEFAULT_AGENT": "dewee-web-advisor"
  }
}
