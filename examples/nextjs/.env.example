# Only for hosting on plain Node (`next build && next start`). Copy to .env.local.
# On Cloudflare do NOT use .env files (OpenNext compiles them into the worker bundle):
# public values live in wrangler.jsonc "vars", secrets in .dev.vars locally and `wrangler secret put` in production.

# CCP Website chat integration (recommended). Values from the CCP "Website chat" page; agents,
# sign-in mode and limits are set there.
DEWEE_CCP_CHAT_URL=https://app.dewee.sh/api/public/webchat/v1/wci_replace_with_your_id
DEWEE_WEBCHAT_INTEGRATION_ID=
# dwc_… secret, server-side only
DEWEE_WEBCHAT_INTEGRATION_SECRET=
# >= 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEWEE_WEBCHAT_SECRET=
# Optional: other sites allowed to call this backend (comma-separated origins)
# DEWEE_ALLOWED_ORIGINS=https://example.com

# Deprecated legacy-gateway transport: comment out the three CCP variables above, then
# DEWEE_WEBCHAT_TRANSPORT=legacy-gateway
# DEWEE_GATEWAY_URL=https://dewee.zuey.me
# DEWEE_GATEWAY_TOKEN=
# DEWEE_AGENTS=dewee-web-advisor,zuey-ai
# DEWEE_DEFAULT_AGENT=dewee-web-advisor
