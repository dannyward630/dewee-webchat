# Copy to .env (never commit it). Real environment variables take precedence.
DEWEE_GATEWAY_URL=https://your-gateway.example.com
# Gateway token or a scoped operator API key. Server-side only.
DEWEE_GATEWAY_TOKEN=
# >= 32 random chars, e.g. `php -r "echo bin2hex(random_bytes(32));"`
DEWEE_WEBCHAT_SECRET=
# Comma-separated allowlist (first = default) or * for every active agent.
DEWEE_AGENTS=support
# DEWEE_DEFAULT_AGENT=support
# DEWEE_TENANT_ID=
# DEWEE_ALLOWED_ORIGINS=https://www.example.com
# DEWEE_ALLOW_CLIENT_CREDENTIALS=false
# DEWEE_CLIENT_CREDENTIAL_HOSTS=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
