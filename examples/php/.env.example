# Copy to .env (never commit it). Real environment variables take precedence.

# CCP Website chat integration (recommended). Values from the CCP "Website chat" page; agents and
# limits are set there. The PHP backend serves anonymous visitors only (no signed-in mode).
DEWEE_CCP_CHAT_URL=https://app.dewee.sh/api/public/webchat/v1/wci_replace_with_your_id
DEWEE_WEBCHAT_INTEGRATION_ID=
# dwc_… secret, server-side only
DEWEE_WEBCHAT_INTEGRATION_SECRET=
# >= 32 random chars, e.g. `php -r "echo bin2hex(random_bytes(32));"`
DEWEE_WEBCHAT_SECRET=
# DEWEE_ALLOWED_ORIGINS=https://www.example.com
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Deprecated legacy-gateway transport: comment out the three CCP variables above, then
# DEWEE_WEBCHAT_TRANSPORT=legacy-gateway
# DEWEE_GATEWAY_URL=https://your-gateway.example.com
# DEWEE_GATEWAY_TOKEN=
# DEWEE_AGENTS=support
# DEWEE_DEFAULT_AGENT=support
# DEWEE_TENANT_ID=
# DEWEE_ALLOW_CLIENT_CREDENTIALS=false
# DEWEE_CLIENT_CREDENTIAL_HOSTS=
