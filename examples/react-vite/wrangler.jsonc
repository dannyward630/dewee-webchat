{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dewee-webchat-react",
  "account_id": "7ac87c90789159ae1b10b7d78f5dcc08",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Vite plugin fills in assets.directory with the client build output.
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "webchat-react.dewee.sh", "custom_domain": true }],
  "workers_dev": false,
  // Public settings. Secrets (DEWEE_GATEWAY_TOKEN, DEWEE_WEBCHAT_SECRET) go in .dev.vars locally
  // and `wrangler secret put` in production.
  "vars": {
    // CCP Website chat (recommended): uncomment these two, remove the legacy block below, and set the
    // secret with `wrangler secret put DEWEE_WEBCHAT_INTEGRATION_SECRET`. Agents are chosen in CCP.
    // "DEWEE_CCP_CHAT_URL": "https://app.dewee.sh/api/public/webchat/v1/wci_…",
    // "DEWEE_WEBCHAT_INTEGRATION_ID": "wci_…",
    // Deprecated direct-gateway transport, used by the hosted demo until it has a CCP integration.
    "DEWEE_WEBCHAT_TRANSPORT": "legacy-gateway",
    "DEWEE_GATEWAY_URL": "https://dewee.zuey.me",
    "DEWEE_AGENTS": "dewee-web-advisor,zuey-ai",
    "DEWEE_DEFAULT_AGENT": "dewee-web-advisor"
  }
}
